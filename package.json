{
  "name": "mine3d-embedded",
  "version": "0.2.0",
  "description": "Mine3D Embedded — WebGL-движок 3D-рендера Minecraft-скинов",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "dev:basic": "vite --config vite.basic.config.ts",
    "build": "tsc && vite build",
    "build:lib": "tsc",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "prepare": "npm run build:lib"
  },
  "keywords": [
    "minecraft",
    "skin",
    "3d",
    "three.js",
    "webgl",
    "skin3d",
    "mine3d",
    "viewer"
  ],
  "author": "Undefined Studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/undefined-studio/mine3d-embedded.git"
  },
  "bugs": {
    "url": "https://github.com/undefined-studio/mine3d-embedded/issues"
  },
  "homepage": "https://github.com/undefined-studio/mine3d-embedded#readme",
  "peerDependencies": {
    "three": "^0.156.1"
  },
  "dependencies": {
    "skin3d": "^0.1.3",
    "skinview-utils": "^0.7.1"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "three": "^0.156.1",
    "typescript": "^5.3.0",
    "vite": "^5.4.0"
  }
}
